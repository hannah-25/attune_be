#!/usr/bin/env bash
# 전체 검증: 빌드 + 테스트 + ArchUnit(아키텍처 규칙) + 문서/시크릿 점검.
# CI 의 build 잡과 동일한 게이트. PR 전 이걸 통과시킨다.
source "$(dirname "$0")/_lib.sh"

log "1/3 빌드+테스트+아키텍처 (gradle build)"
if ! "$GRADLE" build "$@"; then
  fail "build 실패." "테스트/ArchUnit 위반 확인. build/reports/ 참고"
fi

log "2/3 시크릿 누출 점검 (추적 파일 대상)"
if git ls-files | grep -E 'application-secret\.yml$' >/dev/null 2>&1; then
  fail "application-secret.yml 이 git 에 추적되고 있습니다." "git rm --cached 후 .gitignore 확인"
fi
ok "추적 파일에 시크릿 파일 없음"

log "3/3 문서 점검"
bash "$SCRIPT_DIR/check-docs" || warn "문서 점검 경고 있음(비차단)"

ok "verify 통과"
