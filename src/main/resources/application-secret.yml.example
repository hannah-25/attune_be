# application-secret.yml 예시
# ─────────────────────────────────────────────────────────────
# 실제 시크릿을 채워 같은 디렉터리에 application-secret.yml 로 복사한다.
# application-secret.yml 은 .gitignore 로 추적되지 않는다. 절대 커밋하지 말 것.
# 키 이름은 실제 @ConfigurationProperties / @Value 바인딩 기준이다(코드와 일치).
# 프로파일별 값이 다르면 ---(YAML 문서 구분)로 나눠 on-profile 로 분리한다.
# ─────────────────────────────────────────────────────────────

# DB (local/dev/prod 모두 MySQL — local 도 datasource 를 여기서 주입한다.
# test 는 Testcontainers MySQL 을 자동 기동하므로 secret 불필요)
spring:
  datasource:
    url: jdbc:mysql://<host>:3306/attune?serverTimezone=Asia/Seoul
    username: <db-user>
    password: <db-password>
  data:
    redis:
      host: <redis-host>
      port: 6379
  mail:
    username: <smtp-username>
    password: <smtp-app-password>

# JWT (common/config/JwtConfig)
# 만료 시간 단위는 "초" 다. JwtConfig 주석(// 초단위) + JwtProvider 가 *1000L 로 ms 변환한다.
# 값은 main config 기준(docs/token-refresh-api-spec.md). 환경별로 조정 가능.
jwt:
  secret-key: <base64-secret-key>
  access-token-expiration: 3600    # 초 = 1시간
  refresh-token-expiration: 604800 # 초 = 7일

# Web Push / VAPID (alarm/config/WebPushProperties: notification.push.web-push)
notification:
  push:
    provider: web-push   # local 은 stub
    web-push:
      public-key: <vapid-public-key>
      private-key: <vapid-private-key>
      # subject 는 비밀 아님 → application.yml 공통 기본값 사용 가능

# Google Gemini (ai/config/GeminiProperties: prefix=gemini)
gemini:
  api-key: <gemini-api-key>
  base-url: <gemini-base-url>
  model: <gemini-model>

# Sentry DSN (observability/SentrySanitizationConfig, prefix=sentry)
# enabled/environment/release 등 토글은 비밀이 아니므로 application.yml 기본값 +
# 배포 환경변수(SENTRY_ENABLED, APP_RELEASE)로 관리한다. 여기에는 DSN만 둔다.
sentry:
  dsn: <sentry-dsn>

# Admin 감사 로그 HMAC (admin.audit)
admin:
  audit:
    hmac-secret: <admin-audit-hmac-secret>

# OAuth (auth/adapter/oauth, calendar)
oauth:
  google:
    client-ids: <google-client-id-1>,<google-client-id-2>
    client-secret: <google-client-secret>
    calendar-client-id: <google-calendar-client-id>
  apple:
    app-id: <apple-app-id>

# 앱 공통
app:
  frontend-url: <frontend-base-url>
  user:
    deletion-retention-days: 30
